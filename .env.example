APP_NAME=Scientific Research Collaboration Lab
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=sqlite:///./data/research_lab.db

# LLM Provider: "groq", "openai", "anthropic", or "scientific_reasoner"
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Workflow settings
MAX_REVISIONS=3
AGENT_TIMEOUT_SECONDS=120

# Literature search: set ENABLE_LIVE_SEARCH=true to use real OpenAlex / Semantic Scholar APIs
ENABLE_LIVE_SEARCH=false
OPENALEX_EMAIL=research@lab.ai
SEMANTIC_SCHOLAR_API_KEY=
